{
  "_说明": [
    "这是 ec-lab 的配置模板（config.example.json）。config.json 不存在时，程序会自动复制本文件生成一份。",
    "data_dir: 数据文件夹路径（可多个，递归扫描）。新装的软件这里是空的，请在界面里点『添加文件夹』。",
    "mass_mg: 每个样品的活性物质质量 mg，必须逐个登记；未登记的样品会被跳过，绝不使用 * 兜底值。",
    "output.dir: 输出文件夹；null 表示用程序目录下的 output 文件夹。",
    "plot_style / plot_style_by_kind: 六类图的绘图样式默认值，可在界面里调，改完自动写回本文件。",
    "本文件由 ec-lab 自动维护，每次写回前会自动备份到 _cfg_backup 文件夹。"
  ],
  "_主题": "classic",
  "_titles_migrated": true,
  "data_dir": [],
  "area_cm2": 1.0,
  "pick_segments": [
    2,
    3
  ],
  "cv_segments": [],
  "gcd_segments": [],
  "cycle_start": 30,
  "cycle_step": 10,
  "cv_cycle_start": 30,
  "cv_cycle_step": 10,
  "gcd_cycle_start": 30,
  "gcd_cycle_step": 10,
  "skip_keywords_cv": [
    "活化"
  ],
  "ir_free": false,
  "gcd_continuous": false,
  "dedupe_condition": true,
  "exclude_filename": [
    "-fit",
    "副本"
  ],
  "mass_mg": {},
  "eis": {
    "fit": true,
    "circuit": "auto",
    "use_external_fit": true,
    "export_zview": false
  },
  "output": {
    "formats": [
      "png"
    ],
    "dpi": 600,
    "dir": null
  },
